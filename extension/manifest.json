{
  "manifest_version": 3,
  "name": "ASB+ Course and Schedule Workspace",
  "version": "0.3.0",
  "description": "Show live ASB+ course, grade, and requirement details on Schedule Builder and search sections.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://tamu.collegescheduler.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ASB+ overlay",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://tamu.collegescheduler.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
