{
  "manifest_version": 3,
  "name": "ASB+ Course and Schedule Workspace",
  "version": "0.2.0",
  "description": "Show local course, grade, and requirement details on Schedule Builder and search saved sections.",
  "permissions": ["storage"],
  "host_permissions": ["https://tamu.collegescheduler.com/*"],
  "action": {
    "default_title": "ASB+ overlay",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://tamu.collegescheduler.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
